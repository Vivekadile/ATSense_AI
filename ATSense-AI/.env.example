# Groq API key used for the LLM layer (backend/llm.py):
#   - qualitative AI analysis on top of the ATS report
#   - optional skill/experience extraction (see LLM_EXTRACTION_ENABLED)
# Without it, the app still runs fully on the deterministic pipeline.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default Groq model.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: seconds before a Groq request times out.
GROQ_TIMEOUT=30

# Use the LLM to help extract skills/years/education (deterministic fallback
# always applies). When true, LLM output feeds the score, so the same resume
# can score differently between runs. Keep false for a reproducible score.
LLM_EXTRACTION_ENABLED=false

# Max resume upload size in bytes (default 5 MB) and max job-description length.
MAX_UPLOAD_BYTES=5242880
MAX_JD_CHARS=50000

# Comma-separated allowed CORS origins. "*" allows all (dev only).
CORS_ORIGINS=*
